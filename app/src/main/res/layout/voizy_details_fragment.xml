<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_voizy_details_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/voizy_purple"
        android:textSize="35.5sp"
        tools:text="I am down!" />

    <TextView
        android:id="@+id/tv_voizy_details_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_voizy_details_title"
        android:textSize="27sp"
        android:textColor="@color/voizy_purple"
        tools:text="4s" />

    <TextView
        android:id="@+id/tv_voizy_details_tags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="26.5sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.6"
        android:tint="@color/voizy_orange"
        tools:text="#accept #down #reaction"
        tools:tint="@android:color/black" />


    <com.voizy.android.ui.widget.PlayPauseButton
        android:id="@+id/btn_details_playback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_voizy_details_tags"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_voizy_details_duration"
        android:tint="@color/voizy_orange"
        tools:tint="@android:color/black" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_details_share_voizy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_voizy_details_tags"
        app:fabCustomSize="83dp"
        app:maxImageSize="34dp"
        android:backgroundTint="@android:color/white"
        android:src="@drawable/round_share_black_48"
        android:tint="@color/voizy_orange" />


</androidx.constraintlayout.widget.ConstraintLayout>