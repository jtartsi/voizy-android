<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_cloud_video_pull_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/wv_cloud_video_pull"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/view_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:background="@color/voizy_orange"
            app:layout_constraintBottom_toTopOf="@+id/btn_cloud_video_pull_youtube" />

        <ImageButton
            android:id="@+id/btn_cloud_video_pull_home"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/round_home_black_48"
            app:layout_constraintBottom_toTopOf="@+id/et_cloud_video_pull_url"
            app:layout_constraintEnd_toStartOf="@+id/btn_cloud_video_pull_soundcloud"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btn_cloud_video_pull_soundcloud"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginBottom="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/soundcloud_logo"
            app:layout_constraintStart_toEndOf="@id/btn_cloud_video_pull_home"
            app:layout_constraintBottom_toTopOf="@+id/et_cloud_video_pull_url"
            app:layout_constraintEnd_toStartOf="@+id/btn_cloud_video_pull_youtube"
            app:layout_constraintHorizontal_bias="0.5" />

        <ImageButton
            android:id="@+id/btn_cloud_video_pull_youtube"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginBottom="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/youtube_social_icon_white"
            app:layout_constraintBottom_toTopOf="@+id/et_cloud_video_pull_url"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/btn_cloud_video_pull_soundcloud" />

        <EditText
            android:id="@+id/et_cloud_video_pull_url"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_insert_url"
            android:paddingStart="16dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_cloud_video_pull_next"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btn_cloud_video_pull_next"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:backgroundTint="@color/voizy_orange"
            android:src="@drawable/round_arrow_forward_black_48"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_cloud_video_pull_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible"
        android:background="@color/dark_transparent_overlay_50">

        <ProgressBar
            android:id="@+id/pb_cloud_video_pull_loader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:progressDrawable="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.44" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>