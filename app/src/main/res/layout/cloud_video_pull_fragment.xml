        <EditText
            android:id="@+id/et_cloud_video_pull_url"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_insert_url"
            android:paddingStart="16dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_cloud_video_pull_next"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btn_cloud_video_pull_next"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:backgroundTint="@color/voizy_orange"
            android:src="@drawable/round_arrow_forward_black_48"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_cloud_video_pull_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible"
        android:background="@color/dark_transparent_overlay_50">

        <ProgressBar
            android:id="@+id/pb_cloud_video_pull_loader"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:progressDrawable="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.44" />

        <TextView
            android:id="@+id/tv_cloud_video_pull_dl_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/pb_cloud_video_pull_loader"
            app:layout_constraintStart_toStartOf="@+id/pb_cloud_video_pull_loader"
            app:layout_constraintTop_toBottomOf="@+id/pb_cloud_video_pull_loader"
            android:textColor="@color/voizy_orange"
            android:textSize="24sp"
            tools:text="50%" />

