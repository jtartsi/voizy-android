<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="50dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_voizy_row_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.6"
        android:text="Go Real Madrid F.C."
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_bias="0.14"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_voizy_row_shares"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="150 shares"
        android:textSize="18sp"
        android:gravity="center_vertical"
        android:inputType="textCapSentences"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        app:layout_constraintStart_toEndOf="@+id/tv_voizy_row_title"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/divider_light"
        app:layout_constraintBottom_toBottomOf="parent" android:id="@+id/view"/>

</androidx.constraintlayout.widget.ConstraintLayout>